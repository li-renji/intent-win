# 奇点 Windows Agent 配置（键与 ai_service《AI本地Agent调用文档 v1.9》对齐）
# 格式：key=value，# 开头为注释

# ---- LLM（云端 / 本地二选一，llm_mode 决定；调度原则：用一个调一个，不用不调）----
llm_mode=cloud
# cloud：OpenAI 兼容端点（占位，真实 key 不得写入仓库/文档/日志）
# 走本机网关：网关负责路径改写、prompt 裁剪（防手机端 MNN 崩溃）、超时重试、手机 IP 自动发现
base_url=http://<手机IP>:9999/v1
api_key=<你的API Key>
model=qwen2.5-1.5b-mnn
# 手机网关地址（phone 工具用：把任务交给手机上的奇点OS智能体执行）
phone_gateway=http://127.0.0.1:9997/agent/run
# local：llama.cpp / MiniCPM 等 OpenAI 兼容端点
llm_base_url=http://127.0.0.1:80
llm_model=minicpm-2b

# ---- 三端口（语义钉死：6800 对话 / 6801 内部工具总线 / 6802 对外 API）----
host=127.0.0.1
port_6800=6800
port_6801=6801
http_enabled=on
http_port=6802
# 仅 loopback 免鉴权；改非 127.0.0.1 时强制校验 Bearer api_key
http_host=127.0.0.1

# ---- token 最小化管线（phi-agent 式）----
# 工具清单：未列出的工具不注入 schema、不暴露（零未用工具 token）
# browser=内置浏览器  fs=文件读取  code=代码执行  screen=屏幕操控  memo=记忆  skills=技能  phone=手机
tools=fs,code,screen,browser,memo,skills,phone
tool_max_chars=4000
# 历史压缩：每轮只注入 N 条事实摘要，不回灌全量历史
history_facts_n=10
summary_max_chars=2000

# ---- 文件读取（fs 工具）----
fs_read_max_chars=6000
# ---- 代码执行（code 工具）----
code_timeout=60
code_max_chars=6000

# ---- Agent 循环（工具调用，让模型能自主调工具）----
# on=开启（模型可调用 tools 并多轮迭代）；off=退回原来的一问一答
agent_enabled=on
# 单次任务最多几轮模型请求（防死循环）
agent_max_rounds=6
# 单次任务总时长上限（秒）
agent_max_seconds=180
# 工具协议模式：
#   text   = 直接用文本协议 [[TOOL: name {json}]]（1.5B 等未训练过 function calling 的小模型用这个）
#   native = 只用原生 function calling（tools 参数）
#   auto   = 先试原生，被拒再自动降级文本协议
agent_tool_mode=text
# 上游不支持原生 function calling 时，降级用文本协议
agent_text_fallback=on
# 单次工具结果回灌的最大字符数
agent_max_tool_result=1500
# 需要用户确认才能执行的工具（逗号分隔，留空=都要确认）；当前界面无交互确认，留空
agent_confirm_tools=

# ---- 电脑文件桥（手机 qidian编辑器 无线访问/写入本机文件；Node 版 pc_bridge 的 Python 原生移植）----
# on=随 Agent 自启；off=在界面「📱 电脑文件桥」一键启停（默认关：暴露文件给局域网需知情）
pc_bridge_enabled=off
# 端口（手机端默认连 8899，改动需同步改手机设置）
pc_bridge_port=8899
# 访问范围限制：留空=所有盘符；填目录则手机只能看到该目录树，如 D:\代码
pc_bridge_root=
# 连接码存放文件（删了重启会生成新码）
pc_bridge_token_file=pc_bridge.token

# ---- 内置本地推理引擎（llama.cpp llama-server 子进程 + models/ 里的 GGUF 模型）----
# 形态对齐手机端：模型在内置推理引擎进程里跑，并通过稳定的 OpenAI 兼容端口对外服务
# 引擎二进制路径（必填才能启动）：下载 llama.cpp Windows 发行包后填 llama-server.exe 全路径
#   官方发行包: https://github.com/ggml-org/llama.cpp/releases
#   本机无独显、仅 4 核 CPU → 建议选 CPU 发行包，切勿设过大 gpu_layers
local_engine_binary=
# 要加载的 GGUF 模型路径（可用模型管理器激活后自动写入）
local_engine_model=
local_engine_host=127.0.0.1
local_engine_port=8099
# 上下文长度：本机 11.8GB 内存，建议 2048~4096，越大越吃内存
local_engine_ctx=2048
# 推理线程数：0=自动（本机检测为 4）
local_engine_threads=0
# GPU 层数：本机为 Intel 集显无 CUDA，必须 0（非 0 会启动失败）
local_engine_gpu_layers=0
# 额外参数（空格分隔），例：--no-mmap
local_engine_extra_args=
# 启动就绪等待上限（秒）；超时即判定失败并给出可枚举原因，不无限等
local_engine_ready_timeout=90
# on=随应用自动启动引擎
local_engine_autostart=off
# 本地引擎不可用时是否降级到云端接口（off=直接报错）
local_engine_fallback_cloud=on
# 本地模型存放目录（相对项目根；约定同手机端 files/models/<id>/）
local_models_dir=models

# ---- 内置浏览器（引擎无关协议 + WebView2 适配器）----
browser_enabled=on
browser_engine=webview2
browser_width=1280
browser_height=860
# 快照 = 元素编号表 + 正文摘要，全部文本化，不发 HTML 不截图
snapshot_max_chars=3500
