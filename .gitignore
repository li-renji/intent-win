# 运行时产物（本地生成，不入库）
shots/
会话/
*.log
__pycache__/
*.pyc

# 插件运行时数据区（各插件自己的记忆/画像/日记，属本地数据非源码）
plugin_data/

# 单实例锁文件（运行时 PID）
.run.pid

# 工具运行时目录（记忆日志等，属本地数据非源码）
.workbuddy/

# 插件运行时状态（插件动作的 pid / 日志，本地数据非源码）
.plugin_state/

# 本地密钥与令牌（绝不能入库；配好后只在你自己机器上）
# ⚠️ 配置.qdai 内含 api_key / 模型配置，绝不能提交：
#    仓库只提供 配置.example.qdai（同名键、值为空），新机 clone 后复制过去再填自己的 key
配置.qdai
pc_bridge.token
配置.local.qdai

# 知识库索引（运行时生成，README 已声明不入库）
kb/

# 长期记忆持久化（运行时生成，跨会话累积，属个人数据）
memories/

# 本地模型（GB 级，用 配置.qdai 的 local_engine_model 指向即可）
models/*
!models/.gitkeep

# 推理引擎二进制（llama.cpp 官方 release 下载，非本仓库源码；clone 后按 README 自取）
engine/

# 开发时临时文件
.idea/
.vscode/
*.swp
build/
dist/

# 手机网关真实密钥（本地用，绝不入库；源码改从环境变量 PHONE_KEY / phone.key 读取）
phone.key

# 系统备份（个人隐私数据，非项目源码）
backups/

# 自带运行时（Python + WebView2 + Chromium，合计约 2GB 二进制）
# 不是源码，绝不入库；换机直接整体拷贝 D:\INTENT-win 文件夹即可带走。
# 从 GitHub clone 的新机只有源码，用一行命令安装器自动补齐 runtime/。
runtime/

# 本地日志与本机环境备份（含完整 PATH / 用户目录，属个人隐私）
logs/
_probe_*

# 构建产物：桌宠帧序列（244 张 PNG，可由 tools/build_assets.py 重新生成）
**/assets/frames/

# 发布中间产物 / 下载的升级包压缩件（源码已分别在 extension-hub/ 与 browser-upgrade/ 内）
_publish/
browser-upgrade/*.zip

# 安装器端到端验收临时目录
tests/_e2e_install/

# 便携版：本地镜像 / 构建产物 / 验收临时目录（都不是源码，绝不入库）
# portable/release/ 是云端更新源，必须入库，不在此列
portable/INTENT-Portable/
portable/dist/
portable/_factory_tmp/
portable/_lnk_probe/

# 工作台运行时数据：可能含用户自己填入的 API Key / 设备节点 / 用量 / 浏览器登录态
workbench/providers.json
workbench/nodes.json
workbench/usage.json
workbench/quota_report.json
workbench/data/
workbench/*.tmp
workbench/*.log
